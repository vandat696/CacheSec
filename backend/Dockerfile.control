FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS dependencies

COPY requirements-dev.lock.txt /tmp/requirements-dev.lock.txt
RUN pip install --disable-pip-version-check --no-cache-dir -r /tmp/requirements-dev.lock.txt

FROM dependencies AS control
WORKDIR /opt/control
COPY app ./app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
CMD ["python", "-m", "uvicorn", "app.control.control_api:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
