CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# Set a PostgreSQL URI in your untracked .env; empty means not configured.
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=3
DATABASE_STATEMENT_TIMEOUT_MS=1000
# Internal control blob storage: explicit absolute private directory, no implicit fallback.
# Leave unset until provisioning storage; it is never used by /health or /ready.
# CONTROL_ARTIFACT_ROOT=C:/path/to/CacheSec/backend/.local/control-store
CONTROL_ARTIFACT_MAX_BLOB_BYTES=1048576
# Independent quotation app configuration (may use the same local PostgreSQL).
QUOTATION_DATABASE_URL=
QUOTATION_DATABASE_CONNECT_TIMEOUT_SECONDS=3
QUOTATION_DATABASE_STATEMENT_TIMEOUT_MS=1000
# Required, distinct random tokens for the standalone local quotation API.
QUOTATION_FIXTURE_READER_TOKEN=
QUOTATION_FIXTURE_OPERATOR_TOKEN=
QUOTATION_MAX_PAGE_SIZE=100
QUOTATION_MAX_BODY_BYTES=65536
QUOTATION_CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
