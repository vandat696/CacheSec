{
  "name": "cachesec-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "templates:build": "node scripts/build-ui-templates.mjs",
    "templates:check": "node scripts/build-ui-templates.mjs --check",
    "test": "node --experimental-strip-types --test --test-isolation=none scripts/chat-state.test.mjs scripts/documents.test.mjs scripts/experiment-config.test.mjs scripts/metrics-model.test.mjs scripts/developer-preview.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "^6.0.3"
  }
}
