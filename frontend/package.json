{
  "name": "cachesec-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "local": "powershell.exe -NoProfile -File ../scripts/start-local.ps1",
    "workspace": "node --experimental-strip-types scripts/open-workspace.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "db:studio": "prisma studio --config prisma.config.ts --port 5555 --browser none",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "templates:build": "node scripts/build-ui-templates.mjs",
    "templates:check": "node scripts/build-ui-templates.mjs --check",
    "test": "node --experimental-strip-types --test --test-isolation=none scripts/chat-state.test.mjs scripts/documents.test.mjs scripts/experiment-config.test.mjs scripts/metrics-model.test.mjs scripts/developer-preview.test.mjs scripts/quotations.test.mjs scripts/database-studio.test.mjs scripts/repositories.test.mjs scripts/code-changes.test.mjs scripts/local-workspace.test.mjs scripts/agent.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prisma": "7.10.1",
    "typescript": "^6.0.3"
  }
}
